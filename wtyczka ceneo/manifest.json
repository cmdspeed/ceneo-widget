{
  "manifest_version": 3,
  "name": "Ceneo - Zapisz do bazy",
  "version": "1.0.0",
  "description": "Dodaje na stronach produktowych Ceneo.pl przycisk pozwalający zapisać nazwę i cenę produktu do własnej bazy (MockAPI).",
  "permissions": [],
  "host_permissions": [
    "https://*.ceneo.pl/*",
    "https://64a28d62b45881cc0ae55762.mockapi.io/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.ceneo.pl/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
